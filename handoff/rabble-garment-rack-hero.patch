+            </span>
+            <h3 className="mt-5 text-sm font-semibold leading-snug">
+              {p.title}
+            </h3>
+            <p className="mt-2 text-xs leading-relaxed text-ink-3">{p.body}</p>
+          </Reveal>
+        ))}
+      </div>
+    </section>
+  );
+}
