+          )}
+
+          {/* side seams */}
+          <path
+            d={`M86 120 C84 200 84 280 86 ${s.hemY}`}
+            fill="none"
+            stroke="#000"
+            strokeWidth="0.7"
+            opacity="0.14"
+          />
+          <path
+            d={`M214 120 C216 200 216 280 214 ${s.hemY}`}
+            fill="none"
+            stroke="#000"
+            strokeWidth="0.7"
+            opacity="0.14"
+          />
+
+          {/* print */}
+          {print && view !== "side" && (
+            <g
+              clipPath={`url(#${clipId})`}
+              style={{ mixBlendMode: "multiply" }}
+            >
+              <Print id={print} ink={ink} box={s.printBox} uid={uid} />
+            </g>
+          )}
+          {/* back-neck woven label */}
+          {isBack && (
+            <rect
+              x="143"
+              y="104"
+              width="14"
+              height="8"
+              rx="1"
+              fill="#f6f5f0"
+              stroke={shade}
+              strokeWidth="0.6"
+            />
+          )}
+        </g>
+      )}
+
+      {hanger && <Hanger uid={uid} />}
+      {tag && view !== "side" && (
+        <NeckTag text={tag} tone={tagTone} uid={uid} />
+      )}
+    </svg>
+  );
+}
