+                height="10"
+                rx="4"
+                fill={shade}
+                opacity="0.9"
+              />
+              <rect
+                x="218"
+                y={s.hemY - 16}
+                width="40"
+                height="10"
+                rx="4"
+                fill={shade}
+                opacity="0.9"
+              />
+              <g stroke="#000" strokeWidth="0.6" opacity="0.18">
+                {Array.from({ length: 30 }, (_, i) => (
+                  <line
+                    key={i}
+                    x1={88 + i * 4.3}
+                    y1={s.hemY - 3}
+                    x2={88 + i * 4.3}
+                    y2={s.hemY + 5}
+                  />
