+            />
+            <rect
+              x="0"
+              y="0"
+              width="300"
+              height="440"
+              fill={`url(#${uid}-light)`}
+            />
+            <rect
+              x="0"
+              y="0"
+              width="300"
+              height="440"
+              fill={`url(#${view === "side" ? `${uid}-side` : `${uid}-fold`})`}
+            />
+            {/* soft drape streaks */}
+            <g filter={`url(#${uid}-soft)`} opacity="0.5">
+              <path
+                d="M112 130 C106 220 106 290 110 360"
