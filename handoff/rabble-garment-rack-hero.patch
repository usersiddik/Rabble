+          <stop offset="1" stopColor="#000" stopOpacity="0.24" />
+        </linearGradient>
+        {/* side-hang fold: heavy shading, like a garment seen edge-on */}
+        <linearGradient id={`${uid}-side`} x1="0" x2="1" y1="0" y2="0">
+          <stop offset="0" stopColor="#000" stopOpacity="0.45" />
