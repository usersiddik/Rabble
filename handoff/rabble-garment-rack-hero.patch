+            </textPath>
+          </text>
+          <text
+            x={cx}
+            y={box.y + 60}
+            textAnchor="middle"
+            fontSize="7"
+            fontWeight="600"
+            letterSpacing="0.3em"
+          >
+            EST. AW26
+          </text>
+        </g>
+      );
+  }
+}
+
+/* ———————————————————————————— hanger + tag ———————————————————————————— */
+
+function Hanger({ uid }: { uid: string }) {
+  return (
+    <g>
+      <defs>
+        <linearGradient id={`${uid}-wood`} x1="0" x2="0" y1="0" y2="1">
