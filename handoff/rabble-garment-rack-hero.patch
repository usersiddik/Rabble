+          </g>
+
+          {/* collar / ribs / details per kind */}
+          {kind === "tee" && (
+            <g>
+              <path
+                d={
+                  isBack
+                    ? "M118 96 C132 102 168 102 182 96 C168 92 132 92 118 96 Z"
