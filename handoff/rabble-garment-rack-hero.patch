+          {kind === "crew" && (
+            <path
+              d={
+                isBack
+                  ? "M112 96 C130 104 170 104 188 96 C170 90 130 90 112 96 Z"
+                  : "M112 96 C124 112 176 112 188 96 C170 88 130 88 112 96 Z"
+              }
+              fill={shade}
+            />
+          )}
+          {kind !== "tee" && kind !== "dress" && (
+            <g>
+              {/* hem + cuff ribs */}
+              <rect
+                x="82"
